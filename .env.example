# ── Discord ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=                        # Token del bot de Discord
GUILD_ID=                             # ID del servidor de Discord

# ── CRCON ────────────────────────────────────────────────────────────────────
CRCON_URL=http://IP_VPS:8010          # URL con auth (bot + collector)
CRCON_API_KEY=                        # API key de CRCON (Settings > API)

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=hll_bot
POSTGRES_USER=hllbot
POSTGRES_PASSWORD=                    # Contraseña segura
POSTGRES_EXTERNAL_PORT=5432           # Puerto expuesto al host (para DBeaver, etc.)

# ── Collector ────────────────────────────────────────────────────────────────
COLLECT_INTERVAL_MINUTES=30           # Cada cuántos minutos el collector busca partidas nuevas
BACKFILL_MATCH_STATS=false            # true = repoblar match_player_stats vacíos y salir

# ── Notificaciones de estado (opcional) ─────────────────────────────────────
# Webhook de Discord para notificaciones de errores y estado del bot/collector
STATUS_WEBHOOK_URL=                   # https://discord.com/api/webhooks/...
STATUS_CHANNEL_ID=                    # ID del canal de status (fallback si no hay webhook)

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                        # Nivel de log del bot (DEBUG, INFO, WARNING, ERROR)
DISCORD_LOG_LEVEL=WARNING             # Nivel de log de la librería discord.py

# ── Timezone ─────────────────────────────────────────────────────────────────
TZ=America/Argentina/Buenos_Aires     # Zona horaria para el snapshot automático
