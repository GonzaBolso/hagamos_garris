# ── Discord ──────────────────────────────────────────────────
DISCORD_TOKEN=
GUILD_ID=

# ── CRCON ────────────────────────────────────────────────────
# URL pública sin auth (para el collector)
CRCON_PUBLIC_URL=http://IP_VPS:7010

# URL con auth (para el bot)
CRCON_URL=http://IP_VPS:8010
CRCON_API_KEY=tu_api_key

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=hll_bot
POSTGRES_USER=hllbot
POSTGRES_PASSWORD=
POSTGRES_EXTERNAL_PORT=5432

# ── Collector ────────────────────────────────────────────────
COLLECT_INTERVAL_MINUTES=30
