# ── Discord ──────────────────────────────────────────────────
DISCORD_TOKEN=
GUILD_ID=
STATUS_CHANNEL_ID=123456789
STATUS_WEBHOOK_URL=https://discord.com/api/webhooks/12345678...
# ── CRCON ────────────────────────────────────────────────────
# URL pública sin auth (para el collector)
CRCON_PUBLIC_URL=http://IP_VPS:7010

# URL con auth (para el bot)
CRCON_URL=http://IP_VPS:8010
CRCON_API_KEY=tu_api_key

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=hll_bot
POSTGRES_USER=hllbot
POSTGRES_PASSWORD=
POSTGRES_EXTERNAL_PORT=5432

# ── Collector ────────────────────────────────────────────────
COLLECT_INTERVAL_MINUTES=30

LOG_LEVEL=INFO
DISCORD_LOG_LEVEL=WARNING
BACKFILL_KILL_EVENTS=false
BACKFILL_MATCH_STATS=false